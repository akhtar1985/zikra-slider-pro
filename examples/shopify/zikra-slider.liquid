{%- comment -%}
  Zikra Slider Pro — Shopify section (v1.3.3)

  Install:
  1. Render the zikra-slider-bootstrap snippet once from layout/theme.liquid
     (see this folder's README.md).
  2. Online Store → Themes → Edit code → Sections → Add a new section →
     name it "zikra-slider" and paste this file.
  3. Theme editor → Add section → "Zikra Slider".
{%- endcomment -%}

{%- liquid
  assign ratio = ''
  case section.settings.image_ratio
    when 'wide'
      assign ratio = '16 / 9'
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '3 / 4'
  endcase

  capture zikra_options
    echo '{"loop":'
    echo section.settings.loop | json
    echo ',"slidesPerView":'
    echo section.settings.slides_per_view | json
    echo ',"gap":'
    echo section.settings.gap | json
    echo ',"centeredSlides":'
    echo section.settings.centered | json
    echo ',"speed":'
    echo section.settings.speed | json
    echo ',"features":{"autoplay":{"enabled":'
    echo section.settings.autoplay | json
    echo ',"delay":'
    echo section.settings.autoplay_delay | json
    echo '}},"arrows":{"enabled":'
    echo section.settings.arrows | json
    echo '},"bullets":{"enabled":'
    echo section.settings.bullets | json
    echo '}}'
  endcapture
-%}

<div
  class="zs-slider zs-no-js"
  data-zikra-slider
  data-zikra-options="{{ zikra_options | escape }}"
  {% if ratio != '' %}data-ratio style="--zs-ratio: {{ ratio }}; --zs-accent: {{ section.settings.accent }};"{% else %}style="--zs-accent: {{ section.settings.accent }};"{% endif %}
>
  {%- for block in section.blocks -%}
    <div class="zs-slide" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {%- assign image_alt = block.settings.image.alt | default: block.settings.heading | default: shop.name -%}
        {%- if forloop.first -%}
          {%- assign image_loading = 'eager' -%}
        {%- else -%}
          {%- assign image_loading = 'lazy' -%}
        {%- endif -%}
        {{ block.settings.image | image_url: width: 1800 | image_tag:
             widths: '480, 720, 960, 1200, 1800',
             sizes: '(min-width: 990px) 70vw, 100vw',
             loading: image_loading,
             alt: image_alt
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'zs-shopify-placeholder' }}
      {%- endif -%}

      {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
        <div class="zs-shopify-caption">
          {%- if block.settings.heading != blank -%}
            <h2 class="zs-shopify-heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="zs-shopify-text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
            <a class="zs-shopify-button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% style %}
  #shopify-section-{{ section.id }} { padding-block: {{ section.settings.section_padding }}px; }
  #shopify-section-{{ section.id }} .zs-slider { --zs-bullet-color: rgba(255, 255, 255, 0.55); }
  #shopify-section-{{ section.id }} .zs-slide img { display: block; width: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .zs-no-js .zs-slide { flex: 0 0 100%; width: 100%; }
  #shopify-section-{{ section.id }} .zs-slider[data-ratio] .zs-slide img { aspect-ratio: var(--zs-ratio); }
  #shopify-section-{{ section.id }} .zs-shopify-placeholder { display: block; width: 100%; height: auto; background: #e2e8f0; }
  #shopify-section-{{ section.id }} .zs-shopify-caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(16px, 4vw, 40px);
    color: #fff;
    background: linear-gradient(180deg, transparent, rgba(15, 23, 42, 0.72));
  }
  #shopify-section-{{ section.id }} .zs-shopify-heading {
    margin: 0 0 8px;
    font-size: clamp(20px, 3vw, 34px);
    line-height: 1.15;
  }
  #shopify-section-{{ section.id }} .zs-shopify-text { margin: 0 0 16px; opacity: 0.92; }
  #shopify-section-{{ section.id }} .zs-shopify-button {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--zs-accent);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
{% endstyle %}

{% schema %}
{
  "name": "Zikra Slider",
  "tag": "section",
  "class": "zs-shopify-section",
  "settings": [
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "Slides per view",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between slides (px)",
      "min": 0,
      "max": 64,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "centered",
      "label": "Center the active slide",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "adapt", "label": "Natural height" },
        { "value": "wide", "label": "Wide (16:9)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Transition speed (ms)",
      "min": 0,
      "max": 1200,
      "step": 100,
      "default": 600
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color",
      "default": "#6366f1"
    },
    { "type": "header", "content": "Controls" },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "bullets",
      "label": "Show bullet pagination",
      "default": true
    },
    { "type": "header", "content": "Autoplay" },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay (ms)",
      "min": 2000,
      "max": 10000,
      "step": 500,
      "default": 4200
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zikra Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}

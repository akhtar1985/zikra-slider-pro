{
  "name": "zikra-slider-pro",
  "version": "1.3.2",
  "description": "A small, accessible, zero-dependency carousel engine with seven layouts, parallax and a GSAP/anime.js/Motion → WAAPI → CSS animation ladder.",
  "type": "module",
  "types": "dist/zikraslider.d.ts",
  "main": "dist/zikraslider.cjs",
  "module": "dist/zikraslider.esm.js",
  "browser": "dist/zikraslider.umd.js",
  "unpkg": "dist/zikraslider.min.js",
  "jsdelivr": "dist/zikraslider.min.js",
  "style": "dist/zikra-slider.css",
  "exports": {
    ".": {
      "types": "./dist/zikraslider.d.ts",
      "import": "./dist/zikraslider.esm.js",
      "require": "./dist/zikraslider.cjs",
      "default": "./dist/zikraslider.esm.js"
    },
    "./react": {
      "types": "./react/ZikraSlider.d.ts",
      "import": "./react/ZikraSlider.js",
      "default": "./react/ZikraSlider.js"
    },
    "./css": "./dist/zikra-slider.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "react",
    "examples/shopify"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "demo": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs && eslint . && vitest run && tsc -p tsconfig.json"
  },
  "keywords": [
    "slider",
    "carousel",
    "vanilla-js",
    "zero-dependency",
    "a11y",
    "accessibility",
    "react",
    "nextjs",
    "typescript",
    "gsap",
    "anime",
    "motion"
  ],
  "author": "Zikra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhtar1985/zikra-slider-pro.git"
  },
  "homepage": "https://akhtar1985.github.io/zikra-slider-pro/",
  "bugs": {
    "url": "https://github.com/akhtar1985/zikra-slider-pro/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
